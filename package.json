{
  "name": "dsh-vscode-ide",
  "version": "1.0.0",
  "description": "A lightweight VS Code-like workbench for DeepSeek Harness Web: Monaco editor core, an independent floating workbench window, and opt-in feature modules (SSH, terminals, git, diff).",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "THIRD-PARTY.md",
    "LICENSE",
    "install.mjs",
    "docs/ARCHITECTURE.md",
    "docs/PROBE.md",
    "docs/PUBLISH.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "vscode",
    "monaco",
    "ide",
    "editor",
    "workbench",
    "git",
    "terminal",
    "ssh"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.3-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.25.0",
    "material-icon-theme": "^5.40.0",
    "monaco-editor": "^0.53.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "node scripts/check-boundary.mjs && node scripts/build-monaco.mjs && node scripts/build-xterm.mjs && node scripts/build-icons.mjs && node scripts/build-client.mjs",
    "build:monaco": "node scripts/build-monaco.mjs",
    "build:client": "node scripts/build-client.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "install:desktop": "node install.mjs",
    "build:xterm": "node scripts/build-xterm.mjs",
    "check:boundary": "node scripts/check-boundary.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "check": "npm run typecheck && node scripts/check-boundary.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beiryang/dsh-vscode-ide.git"
  },
  "homepage": "https://github.com/beiryang/dsh-vscode-ide#readme",
  "bugs": {
    "url": "https://github.com/beiryang/dsh-vscode-ide/issues"
  }
}
